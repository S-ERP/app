#!/bin/bash

echo "=================================="
echo "  Limpieza de Gradle Daemons"
echo "=================================="
echo ""

# Contar cuántos hay antes
ANTES=$(ps aux | grep "GradleDaemon" | grep -v grep | wc -l)
echo "Procesos Gradle Daemon encontrados: $ANTES"

if [ "$ANTES" -eq 0 ]; then
    echo "No hay nada que limpiar. Todo tranquilo."
    exit 0
fi

echo ""
echo "Cerrando procesos..."
pkill -f GradleDaemon

# Esperar un segundo para que se cierren bien
sleep 1

# Verificar que se cerraron
DESPUES=$(ps aux | grep "GradleDaemon" | grep -v grep | wc -l)

echo ""
if [ "$DESPUES" -eq 0 ]; then
    echo "✅ Listo. Se cerraron los $ANTES procesos correctamente."
else
    echo "⚠️  Quedan $DESPUES procesos todavía activos. Puede que estén en uso justo ahora."
fi

echo ""
echo "Memoria actual del sistema:"
free -h