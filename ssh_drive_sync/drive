# Verificar el sistema operativo
os_type=$(uname)
if [ "$os_type" == "Darwin" ]; then
    # Es macOS
    stat_size_cmd="stat -f \"%z\""
    stat_mtime_cmd="stat -f \"%m\""
    touch_cmd="touch -t \$(date -r \$last_modified +\"%Y%m%d%H%M.%S\")"
else
    # Asumir que es Linux (Ubuntu)
    stat_size_cmd="stat -c \"%s\""
    stat_mtime_cmd="stat -c \"%Y\""
    touch_cmd="formatted_date=\$(date -d \"@\$last_modified\" +\"%Y%m%d%H%M.%S\") && touch -t \"\$formatted_date\""
fi

