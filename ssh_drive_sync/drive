PATH_LAST_FILES_SERVER="$script_dir/.last_files_server.txt"

declare -a deleted_files=()

action-ls() {
    local url="$1"
    local response=$(curl --silent --location "$DRIVE_API/api" \
        --header 'Content-Type: application/json' \
        --data '{
            "component": "file",
            "type": "ls",
            "path":"'$url'",
            "estado": "cargando"
        }')
        echo "$response" | awk -F'"data":' '{print $2}' | awk -F']' '{print $1"]"}'
}

action-lsr() {
    local url="$1"
    local response=$(curl --silent --location "$DRIVE_API/api" \
        --header 'Content-Type: application/json' \
        --data '{
            "component": "file",
            "type": "lsr",
            "path":"'$url'",
            "estado": "cargando"
        }')
    
    local estado=$(echo "$response" | awk -F'"estado":' '{print $2}' | awk -F'"' '{print $2}')
    
    if [ "$estado" == "exito" ]; then
        echo "$response" | awk -F'"data":' '{print $2}' | awk -F']' '{print $1"]"}'
    fi
}

action-mkdir() {
    local url="$1"
    local response=$(curl --silent --location "$DRIVE_API/api" \
        --header 'Content-Type: application/json' \
        --data '{
            "component": "file",
            "type": "mkdir",
            "path":"'$url'",
            "estado": "cargando"
        }')
    echo "$response"
}

action-rm() {
    local url="$1"
    
    local json='{
        "component": "file",
        "type": "rm",
        "path":"'$url'",
        "estado": "cargando"
    }'
    echo $json
    local response=$(curl --silent --location "$DRIVE_API/api" \
        --header 'Content-Type: application/json' \
        --data "$json")
    echo "$response"
}

log(){
    echo $*
}

url_encode() {
    local url="$1"
    local encoded_url=$(python3 -c "import urllib.parse; print(urllib.parse.quote('''$url'''))")
    echo "$encoded_url"
}

upload_file_in_chunks() {
    local file_path="$1"
    local remote_path="$2"
    local chunk_size=1048576  # Tamaño del chunk en bytes (1 MB)
    local file_size=$(eval "$stat_size_cmd \"$file_path\"")
    if [ "$file_size" -eq 0 ]; then
        file_size=1
    fi
    local total_chunks=$(( (file_size + chunk_size - 1) / chunk_size ))  # Calcula el número total de chunks
    local last_modified=$(eval "$stat_mtime_cmd \"$file_path\"")
    last_modified=$((last_modified * 1000))

    for ((chunk_number=1; chunk_number<=total_chunks; chunk_number++)); do
        offset=$(( (chunk_number - 1) * chunk_size ))
        urlserver="$DRIVE_API/uploadv2"
        cnum=$((chunk_number - 1))
        finalurl="$urlserver$remote_path?chunkNumber=${cnum}&totalChunks=${total_chunks}&lastModified=${last_modified}"
        response=$(curl --silent --location --request POST "$finalurl" \
            --header 'Content-Type: application/octet-stream' \
            --data-binary "@$file_path" --range $offset-$((offset + chunk_size - 1)))
        echo "$response / $total_chunks"
    done
}

descargar_archivos_del_servidor(){
    lista_de_archivos_server=$(action-lsr "$FILE_TO_SYNC")
    while read -r line; do
        name=$(echo "$line" | awk -F'"name":"' '{print $2}' | awk -F'"' '{print $1}')
        type=$(echo "$line" | awk -F'"type":"' '{print $2}' | awk -F'"' '{print $1}')
        path=$(echo "$line" | awk -F'"path":"' '{print $2}' | awk -F'"' '{print $1}')
        last_modified=$(echo "$line" | awk -F'"lastModified":' '{print $2}' | awk -F'[^0-9]*' '{print $1}')
        last_modified=$((last_modified / 1000))
        local_path_file="$PATH_LOCAL$path"

        if [ -f "$local_path_file" ]; then
            local_modified=$(eval "$stat_mtime_cmd \"$local_path_file\"")
            
            if (( last_modified > local_modified )); then
                echo "[MODIFICADO SERVER][f] $path"
            elif (( last_modified < local_modified )); then
                continue;
            else
                continue;
            fi
        elif [ -d "$local_path_file" ]; then
            continue;
        else
            if [[ "$type" == "directory" ]]; then
                echo "[OK][MKDIR][d] $path"
                mkdir -p "$local_path_file"
            else 
                curl --silent --location "$DRIVE_API$path" --output "$local_path_file"
                eval "$touch_cmd \"$local_path_file\""
                echo "[OK][DESCARGAR][f] $path "
            fi
        fi
    done < <(echo "$lista_de_archivos_server" | grep -o '{[^}]*}')

    echo "$lista_de_archivos_server" > $PATH_LAST_FILES_SERVER
}

